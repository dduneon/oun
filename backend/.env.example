# 서버
NODE_ENV=development
PORT=3000

# DB (docker-compose 기준)
DATABASE_URL="postgresql://oun:oun_dev_pw@localhost:5432/oun?schema=public"

# JWT — 로컬 개발용 시크릿. 운영에서는 반드시 교체.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# 카카오 로그인 (선택 — 없으면 카카오 로그인만 비활성, dev 로그인은 동작)
# 앱이 카카오 SDK로 받은 access token을 서버로 넘기면 서버가 카카오 API로 검증한다.
KAKAO_ADMIN_KEY=

# MinIO (오브젝트 스토리지 — 운동 인증 사진 등)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=oun
MINIO_SECRET_KEY=oun_dev_pw
MINIO_BUCKET=oun-media
MINIO_PUBLIC_URL=http://localhost:9000
