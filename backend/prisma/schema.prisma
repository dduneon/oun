// 오운(Oun) 데이터 모델 — 구현된 앱 화면 기준.
// 재화는 CurrencyLedger에 append-only + 멱등키 + 트랜잭션으로만 증감(서버가 source of truth).

generator client {
  provider = "prisma-client-js"
}

// MariaDB. Prisma는 MariaDB를 mysql 프로바이더로 다룬다.
// Postgres와 달리 String 기본형이 varchar(191)이라, 191자를 넘을 수 있는
// 자유 입력 필드에는 @db.Text를 명시한다(누락하면 런타임에 잘림/에러).
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 유저 & 프로필
// ─────────────────────────────────────────────────────────────

enum Gender {
  f // 여성 캐릭터
  m // 남성 캐릭터
}

model User {
  id           String   @id @default(cuid())
  kakaoId      String?  @unique // 카카오 로그인 식별자 (dev 유저는 null)
  username     String?  @unique // 자격 로그인 아이디 (카카오/dev 유저는 null)
  passwordHash String? // bcrypt 해시 (자격 로그인 유저만)
  nickname     String   @unique // @nickname (친구 추가·프로필)
  displayName  String
  gender       Gender   @default(f)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ledger            CurrencyLedger[]
  workouts          WorkoutLog[]
  characterStat     CharacterStat?
  characterMood     CharacterMood?
  streak            Streak?
  streakProtector   StreakProtector?
  restDays          RestDay[]
  userQuests        UserQuest[]
  inventory         Inventory[]
  equipped          Equipped[]
  shopOrders        ShopOrder[]
  userAchievements  UserAchievement[]
  friendships       Friendship[]      @relation("FriendshipOwner")
  friendOf          Friendship[]      @relation("FriendshipTarget")
  friendReqSent     FriendRequest[]   @relation("FriendReqFrom")
  friendReqReceived FriendRequest[]   @relation("FriendReqTo")
  cheersSent        Cheer[]           @relation("CheerFrom")
  cheersReceived    Cheer[]           @relation("CheerTo")
  notifications     Notification[]
  deviceTokens      DeviceToken[]
  crewMemberships   CrewMember[]
  crewJoinRequests  CrewJoinRequest[]
  crewPosts         CrewPost[]
  crewComments      CrewComment[]
  crewPostCheers    CrewPostCheer[]
  crewRewardClaims  CrewRewardClaim[]
}

// ─────────────────────────────────────────────────────────────
// 재화 원장 (절대 클라이언트에서 계산 금지)
// ─────────────────────────────────────────────────────────────

enum LedgerReason {
  workout_reward
  quest_reward
  achievement
  shop_purchase
  rest_day
  refund
}

model CurrencyLedger {
  id             String       @id @default(cuid())
  userId         String
  delta          Int // 증감 (+획득 / -차감)
  balanceAfter   Int // 이 트랜잭션 직후 잔액 = 최신 값이 현재 잔액
  reason         LedgerReason
  refType        String? // 연관 엔티티 종류 (workout_log / quest / shop_order ...)
  refId          String? // 연관 엔티티 id
  idempotencyKey String       @unique // 중복 보상/차감 차단
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// 운동 기록 & 검증
// ─────────────────────────────────────────────────────────────

enum Sport {
  running
  walking
  weight
  cycling
  yoga
  etc
}

enum BodyPart {
  upper
  lower
  full
  core
}

enum WorkoutSource {
  manual
  healthkit
  health_connect
}

enum VerifyStatus {
  pending
  verified
  rejected
}

model WorkoutLog {
  id           String        @id @default(cuid())
  userId       String
  sport        Sport
  durationSec  Int
  distanceM    Int? // 러닝/자전거
  steps        Int? // 걷기
  bodyPart     BodyPart? // 웨이트
  sets         Int? // 웨이트
  calories     Int?
  photoRef     String?       @db.VarChar(512) // 운동 인증 사진 (S3 키 등, 현재는 존재 여부만)
  source       WorkoutSource @default(manual)
  verifyStatus VerifyStatus  @default(pending)
  rejectReason String?       @db.Text
  performedAt  DateTime // 운동 수행 시각 (mood/캘린더 기준)
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, performedAt])
}

// ─────────────────────────────────────────────────────────────
// 캐릭터 스탯 & mood (살아있는 캐릭터 A)
// ─────────────────────────────────────────────────────────────

// 종목별 파생 스탯을 경험치(포인트)로 누적. 레벨은 서버가 산출.
model CharacterStat {
  userId    String   @id
  endurance Int      @default(0) // 러닝/걷기/자전거
  strength  Int      @default(0) // 웨이트
  agility   Int      @default(0) // 자전거 등
  balance   Int      @default(0) // 요가
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Mood {
  energetic
  happy
  neutral
  hungry
  sleepy
}

// mood는 lastWorkoutAt·streak로 산출되는 파생값. 조회 시 재계산 후 캐시.
model CharacterMood {
  userId        String    @id
  mood          Mood      @default(neutral)
  lastWorkoutAt DateTime?
  streakActive  Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Care System (스트릭 / 보호권 / 휴식일)
// ─────────────────────────────────────────────────────────────

model Streak {
  userId         String    @id
  current        Int       @default(0)
  longest        Int       @default(0)
  lastActiveDate DateTime? // 마지막으로 스트릭이 이어진 날 (날짜 단위)
  protectedUntil DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StreakProtector {
  userId    String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RestDay {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime // 날짜 단위 (UTC 00:00)
  rewarded Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─────────────────────────────────────────────────────────────
// 퀘스트 (일일/주간/도전)
// ─────────────────────────────────────────────────────────────

enum QuestKind {
  daily
  weekly
  challenge
}

// 퀘스트 정의 (시드). 진행도 증가를 어떤 이벤트에 걸지 trigger로 표현.
model QuestDef {
  id        String    @id @default(cuid())
  key       String    @unique // 예: daily_workout, weekly_3_workouts
  kind      QuestKind
  title     String
  sub       String
  reward    Int // 보상 코인
  goal      Int
  trigger   String // workout_logged | workout_minutes | workout_photo | cheer_sent | streak_days
  icon      String? // 앱 아이콘 매핑용 키
  sortOrder Int       @default(0)

  userQuests UserQuest[]
}

enum QuestState {
  in_progress
  claimable
  claimed
}

// 유저별 퀘스트 진행. periodKey로 리셋 주기를 구분(일일=날짜, 주간=ISO주, 도전=all).
model UserQuest {
  id         String     @id @default(cuid())
  userId     String
  questDefId String
  periodKey  String // 예: 2026-07-20 / 2026-W29 / all
  progress   Int        @default(0)
  state      QuestState @default(in_progress)
  claimedAt  DateTime?
  updatedAt  DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questDef QuestDef @relation(fields: [questDefId], references: [id], onDelete: Cascade)

  @@unique([userId, questDefId, periodKey])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// 상점 / 인벤토리 / 장착
// ─────────────────────────────────────────────────────────────

enum ItemCategory {
  clothing // 의상
  hair // 헤어
  prop // 소품
  furniture // 가구
}

enum ItemRarity {
  common
  rare
  epic
}

// 모든 아이템은 기능 스탯 0 (순수 치장). hasSpecialFx는 시각 효과일 뿐.
model Item {
  key            String       @id // 예: hood_daily
  category       ItemCategory
  name           String
  price          Int // 운동 재화 단위 (무과금)
  rarity         ItemRarity   @default(common)
  hasSpecialFx   Boolean      @default(false)
  addressableKey String? // Unity Addressables 원격 에셋 키
  colorHex       String? // 앱 목업 카드 색 (에셋 전까지 표현용)
  sortOrder      Int          @default(0)

  inventory  Inventory[]
  equipped   Equipped[]
  shopOrders ShopOrder[]
}

model Inventory {
  id         String   @id @default(cuid())
  userId     String
  itemKey    String
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemKey], references: [key], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

// 슬롯당 하나 장착. slot은 카테고리 기준(의상/헤어/소품).
model Equipped {
  id      String @id @default(cuid())
  userId  String
  slot    String
  itemKey String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemKey], references: [key], onDelete: Cascade)

  @@unique([userId, slot])
}

model ShopOrder {
  id             String   @id @default(cuid())
  userId         String
  itemKey        String
  price          Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemKey], references: [key], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// 업적
// ─────────────────────────────────────────────────────────────

model AchievementDef {
  id        String  @id @default(cuid())
  key       String  @unique // 예: first_step, week_perfect
  name      String
  condition String  @db.Text
  trigger   String // 조건 판정 키 (first_workout | streak_7 | photo_10 ...)
  threshold Int     @default(1)
  icon      String?
  sortOrder Int     @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id               String   @id @default(cuid())
  userId           String
  achievementDefId String
  earnedAt         DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDef @relation(fields: [achievementDefId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementDefId])
}

// ─────────────────────────────────────────────────────────────
// 소셜: 친구 & 응원 (랭킹 없음, 칭찬·독려만)
// ─────────────────────────────────────────────────────────────

// 친구는 상호 관계 — 추가 시 양방향 두 행을 함께 만든다.
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// 친구 요청(요청 → 수락/거절). 수락 시 Friendship 두 행을 만든다.
model FriendRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String   @default("pending") // pending | accepted | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User @relation("FriendReqFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendReqTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

// 응원 한 번(이모지). 친구 행의 반응 아이콘·응원 퀘스트/업적의 근거.
model Cheer {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  emoji      String    @default("❤️")
  createdAt  DateTime  @default(now())
  // 받은 사람이 확인한 시각. null이면 아직 못 본 응원(홈 캐릭터 반응 트리거).
  seenAt     DateTime?

  from User @relation("CheerFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("CheerTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, createdAt])
  @@index([toUserId, seenAt])
  @@index([fromUserId])
}

// ─────────────────────────────────────────────────────────────
// 알림: 인앱 알림함(원본) + 푸시 전송 대상 기기
// ─────────────────────────────────────────────────────────────

// 인앱 알림 한 건. 푸시는 이 행을 근거로 "추가 전송"될 뿐이라,
// 푸시가 실패하거나 꺼져 있어도 알림함에는 남는다.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'cheer' | 'friend_request' | 'crew_join' …
  title     String
  body      String    @db.Text
  // 탭했을 때 이동할 곳 등 부가 정보(발신자 닉네임 등).
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// 푸시를 받을 기기 토큰. 같은 토큰이 다른 유저에게 재등록될 수 있어
// token을 unique로 두고 등록 시 소유자를 옮긴다(기기 공유·재로그인).
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(255)
  platform  String // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// 크루: 공동 목표 + 레벨(누적 운동) + SNS 피드
// ─────────────────────────────────────────────────────────────

model Crew {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text // 크루 소개/설명
  isPublic    Boolean  @default(true) // 크루 탐방에 노출할지 여부
  createdAt   DateTime @default(now())

  members      CrewMember[]
  posts        CrewPost[]
  rewardClaims CrewRewardClaim[]
  joinRequests CrewJoinRequest[]
}

// 가입 신청/초대 (하나의 모델로 방향만 다르게 표현).
// - type "request": userId가 이 크루에 가입 신청(공개 크루). 방장이 승인/거절.
// - type "invite" : 방장(invitedBy)이 userId를 초대. 당사자가 수락/거절.
model CrewJoinRequest {
  id        String   @id @default(cuid())
  crewId    String
  userId    String // request: 신청자 / invite: 초대받은 사람
  type      String // "request" | "invite"
  status    String   @default("pending") // pending | accepted | rejected
  invitedBy String? // invite일 때 초대한 방장 userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId, type])
  @@index([userId])
  @@index([crewId])
}

model CrewMember {
  id       String   @id @default(cuid())
  crewId   String
  userId   String
  role     String   @default("member") // leader | member
  joinedAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId])
  @@index([userId])
}

// 크루 피드 글. 유저가 직접 올린다 — 자기 운동 기록을 태그(선택)하거나 글만.
// 크루 레벨의 '누적 활동' = 이 글 수(kind='post'만; 시스템 글은 제외).
model CrewPost {
  id           String   @id @default(cuid())
  // 'post' = 유저가 쓴 글, 'join' = 새 크루원 합류 알림(시스템 글, 수정·삭제 불가).
  // 시스템 글도 같은 테이블이라 응원·댓글이 그대로 붙는다.
  kind         String   @default("post")
  crewId       String
  userId       String
  workoutLogId String? // 태그한 운동(선택). null이면 글만.
  message      String?  @db.Text // 남긴 한마디
  createdAt    DateTime @default(now())

  crew     Crew            @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CrewComment[]
  cheers   CrewPostCheer[]

  // 같은 운동을 같은 크루에 중복 공유 방지(null은 여러 개 허용 = 글만 여러 개 가능).
  @@unique([crewId, workoutLogId])
  @@index([crewId, createdAt])
}

model CrewComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  post CrewPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// 피드 글 응원(토글). 유저당 글 하나에 한 번.
model CrewPostCheer {
  id     String @id @default(cuid())
  postId String
  userId String

  post CrewPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// 크루 레벨 보상 수령 이력(유저별·레벨별 1회).
model CrewRewardClaim {
  id        String   @id @default(cuid())
  crewId    String
  userId    String
  level     Int
  createdAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId, level])
}
