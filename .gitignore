# === macOS ===
.DS_Store
._*

# === IDE ===
.idea/
.vscode/
*.iml

# === Unity (unity/) — 빌드 캐시/산출물은 프로젝트에서 재생성됨 ===
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]serSettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/.vs/
# Unity crash/기타
sysinfo.txt
*.stackdump

# === Unity-as-a-Library export 산출물 (unity/에서 재생성 가능, 대용량) ===
app/ios/unityLibrary/
app/android/unityLibrary/

# 참고: Flutter 앱(app/)의 build/, .dart_tool/ 등은 app/.gitignore가 처리
# 참고: Unity .meta 파일은 반드시 커밋 (무시하지 않음)
